common --enable_bzlmod
common --enable_workspace=false
common --incompatible_enable_cc_toolchain_resolution
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --jobs=8
build --cxxopt=-std=c++17
test --test_output=errors
test --nozip_undeclared_test_outputs

common --flag_alias=enable_mull=//toolchains:enable_mull
build:mull --enable_mull
build:mull --strip=never
build:mull --dynamic_mode=off
build:mull --experimental_exclude_starlark_flags_from_exec_config
